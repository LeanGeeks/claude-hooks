#!/usr/bin/env python3
"""``amux-spawn`` — unified human + agent launcher for amux sessions (epic 10).

This is the CLI: the ``spawn`` subcommand (task 10-01), the read subcommands
``status`` / ``last`` / ``ls`` (task 10-03), the supervise flag
``--wait`` / ``--notify`` (task 10-04), attach / quick-switch ``a|attach``
(task 10-05), the end-of-life ``rm`` subcommand (task 10-06), and the Codex
second-turn ``resume`` subcommand (epic 20, task 20-04).

State is DERIVED at read time (architecture §6); ``stuck`` is never persisted.
Precedence: terminated -> stuck -> running -> idle. ``status`` bundles
cause-agnostic reason-context (background tasks, in-flight foreground tool,
pending permission) assembled from files (architecture §7).

Design stance (architecture s0): thin mechanism. ``spawn`` creates + seeds a new
amux session for both humans (TTY -> attach / switch-client) and agents (non-TTY
-> fire-and-return), with workspace-anchored naming, tracked-vs-plain handling,
and model/env inheritance.

The launch structure (architecture s5/s8) is **create-detached-under-lock then
attach**:

    [ global flock (~/.amux/spawn/.lock), held by ALL spawns ]
      cap-check (tracked only)
      pick a free name vs amux's full namespace
      create the session DETACHED via amux exec --no-attach (E5)
      tracked: write the handle
    [ release the lock ]
    then (TTY, not detached/wait/notify): attach / switch-client

The lock is never held across the blocking attach.

Env/secrets reach the child via tmux ``update-environment`` (amux E1 owns the
allowlist) — amux-spawn only ensures the model/auth vars are present in its OWN
environment and NEVER inlines a secret into the launch command (that would leak
via ``ps``). The minted ``--session-id`` is a valid UUID and is routed by amux
into ``<name>.meta.json`` (E4-floor), never into ``CC_FLAGS``.
"""

from __future__ import annotations

import argparse
import errno
import fcntl
import json
import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

# The shared helpers live alongside the hooks (Phase-0 decision 2). When
# installed, both this script and amux_spawn_lib.py land in ~/.claude/hooks/ on a
# parallel path; in the repo, the lib is under .claude/hooks/. Add both candidate
# locations so the import works either way without depending on repo-local files
# at runtime.
_HERE = Path(__file__).resolve().parent
for _cand in (_HERE, _HERE.parent / "hooks", Path.home() / ".claude" / "hooks"):
    if (_cand / "amux_spawn_lib.py").exists():
        sys.path.insert(0, str(_cand))
        break

import amux_spawn_lib as lib  # noqa: E402

# The pure Codex reducer (task 20-01) lives alongside the lib, so the sys.path
# candidates above already cover it (repo and installed layouts are parallel).
# Import fail-soft: a missing reducer must never break the Claude surface — the
# Codex derivation then degrades to liveness-only (fail-open convention).
try:
    import codex_event_reducer as codex_reducer  # noqa: E402
except Exception:  # noqa: BLE001
    codex_reducer = None


def _eprint(msg: str) -> None:
    print(msg, file=sys.stderr)


# ── Provider selection (epic 20 task 20-02) ───────────────────────────────────
#
# Ownership boundary (epic-20 architecture §1): amux-spawn selects the provider,
# names the session, enforces the cap, allocates the artifacts and writes the
# tracked handle. **amux is the only component that constructs provider
# executable argv** (cross-task invariant 3) — nothing below ever spells a
# `codex …` command line, and `--yolo` is forwarded verbatim so amux can expand
# it AFTER it has resolved the persisted provider (architecture §8).

# Claude-only permission flags. Forwarding one of these to a Codex session would
# be exactly the mistake architecture §8 forbids; amux would reject it too, but
# the caller deserves the actionable message here, before anything is created.
CLAUDE_ONLY_PERMISSION_FLAGS = (
    "--dangerously-skip-permissions",
    "--allow-dangerously-skip-permissions",
)


def _flag_present(flags: list[str], flag: str) -> bool:
    """True if *flag* appears in *flags*, either bare or as ``--flag=value``."""
    return any(f == flag or f.startswith(f"{flag}=") for f in flags)


def resolve_provider(raw: str | None) -> str:
    """Validate ``--provider`` and return the canonical provider name.

    Cross-task invariant 1: the default is ``claude``. Raises ``ValueError``
    with an actionable message for anything outside the supported set.
    """
    value = (raw or lib.PROVIDER_CLAUDE).strip().lower()
    if value not in lib.PROVIDERS:
        raise ValueError(
            f"--provider must be one of: {', '.join(lib.PROVIDERS)} (got {raw!r})"
        )
    return value


# ── flock context ─────────────────────────────────────────────────────────────

class SpawnLock:
    """Exclusive ``flock`` over ``~/.amux/spawn/.lock`` (architecture s8).

    Held by ALL spawns (incl. plain) across [cap-check -> pick name -> create
    detached -> write handle]. Released before any blocking attach.
    """

    def __init__(self) -> None:
        self._fd: int | None = None

    def __enter__(self) -> "SpawnLock":
        lib.ensure_dirs()
        self._fd = os.open(str(lib.SPAWN_LOCK), os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(self._fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *_exc: Any) -> None:
        if self._fd is not None:
            try:
                fcntl.flock(self._fd, fcntl.LOCK_UN)
            finally:
                os.close(self._fd)
            self._fd = None


# ── Dir resolution (D-Workspace) ──────────────────────────────────────────────

def resolve_dir(explicit_dir: str | None, is_tty: bool) -> tuple[str, str | None, str | None]:
    """Resolve the workspace dir and the parent amux name.

    Order (D-Workspace):
      1. ``--dir`` (resolved absolute);
      2. agent/non-TTY -> parent ``CC_DIR`` (via the ``amux-<name>`` trick);
      3. human/TTY -> cwd;
      4. fallback -> cwd + warning.

    Returns ``(abs_dir, parent_name, warning_or_none)``. ``parent_name`` is the
    resolved parent amux session (for run_id / --model inheritance), or None.
    """
    parent = lib.resolve_amux_session()

    if explicit_dir:
        abs_dir = os.path.abspath(os.path.expanduser(explicit_dir))
        return abs_dir, parent, None

    if not is_tty:
        # Agent / non-TTY: inherit the spawning session's CC_DIR (stable down a
        # chain; subdir-proof), NOT the agent's cwd.
        if parent:
            cc_dir = lib.parent_cc_dir(parent)
            if cc_dir:
                return os.path.abspath(cc_dir), parent, None
        # Non-TTY with no resolvable parent: fall back to cwd + warning.
        return os.path.abspath(os.getcwd()), parent, (
            "no parent amux session resolved (bare non-amux caller); "
            "falling back to cwd for the workspace dir"
        )

    # Human / TTY: cwd.
    return os.path.abspath(os.getcwd()), parent, None


# ── run_id / model inheritance ────────────────────────────────────────────────

def resolve_run_id(explicit_run_id: str | None, parent_name: str | None) -> str:
    """run_id: ``--run-id`` overrides; else inherit from the parent handle; else
    mint a new one (D-RunId)."""
    if explicit_run_id:
        return explicit_run_id
    if parent_name:
        parent_handle = lib.read_handle(parent_name)
        if parent_handle and parent_handle.get("run_id"):
            return str(parent_handle["run_id"])
    return lib.mint_uuid()


def inherited_model_flag(caller_flags: list[str], parent_name: str | None) -> str | None:
    """Standard ``--model`` tier inheritance (D-Env).

    Alt-model selection rides on inherited env; the standard ``--model`` tier is
    a flag, not env. When the caller passes no ``--model``, propagate the
    parent's explicit ``--model`` (read from parent ``CC_FLAGS``) so opus->opus
    works. Returns the model to propagate, or None.
    """
    if lib.extract_model_flag(caller_flags) is not None:
        return None  # caller already specified one; don't override
    if parent_name:
        return lib.extract_model_flag(lib.parent_cc_flags(parent_name))
    return None


# ── spawn ─────────────────────────────────────────────────────────────────────

def cmd_spawn(args: argparse.Namespace, claude_flags: list[str], prompt: str | None) -> int:
    """Create + seed a new amux session (task 10-01).

    ``claude_flags`` are the pass-through provider flags (everything amux-spawn
    did not consume). ``prompt`` is the seeded prompt (from after ``--``), or
    None.

    Provider (task 20-02): ``--provider claude`` (the default) is the unchanged
    epic-10 path. ``--provider codex`` launches a **bounded** ``codex exec``
    worker through amux's public options — ``--provider`` / ``--agent-mode`` /
    ``--event-log`` / ``--output-last-message`` — and records the artifacts in
    the handle. It mints no session id and guesses no transcript: a Codex thread
    id only exists once Codex emits it.
    """
    try:
        provider = resolve_provider(getattr(args, "provider", None))
    except ValueError as exc:
        _eprint(f"amux-spawn: error: {exc}")
        return 1
    codex = provider == lib.PROVIDER_CODEX

    # Provider/flag combinations refused with an actionable error (BRD §4.1),
    # BEFORE anything is resolved, exported, locked or created.
    if codex:
        if prompt is None:
            _eprint(
                "amux-spawn: error: --provider codex needs a prompt: a bounded "
                "codex exec run is one seeded turn.\n"
                "  amux-spawn spawn <suffix> --provider codex -- \"do the thing\""
            )
            return 1
        if getattr(args, "profile", None):
            _eprint(
                "amux-spawn: error: --profile is a Claude model profile "
                "(~/.claude/profiles.toml) and cannot be used with "
                "--provider codex.\n"
                "  Pass Codex's own model flag through instead using the "
                "--model=<name> form (the space form's value is eaten by the "
                "optional <suffix> positional), or configure "
                "~/.codex/config.toml."
            )
            return 1
        for flag in CLAUDE_ONLY_PERMISSION_FLAGS:
            if _flag_present(claude_flags, flag):
                _eprint(
                    f"amux-spawn: error: {flag} is a Claude flag and must never "
                    f"reach Codex.\n"
                    "  Use --yolo: amux expands it per provider "
                    "(Codex: --dangerously-bypass-approvals-and-sandbox)."
                )
                return 1

    # Resolve model profile and export its env vars BEFORE the lock so the
    # spawner's live environment (which amux E1 snapshots via update-environment)
    # already carries the profile vars when the session is created.
    if getattr(args, "profile", None):
        try:
            profile_env = lib.resolve_profile(args.profile)
            os.environ.update(profile_env)
        except ValueError as exc:
            _eprint(f"amux-spawn: error: {exc}")
            return 1

    is_tty = sys.stdin.isatty() and sys.stdout.isatty()

    # --wait/--notify force tracked + detached even at a TTY (you await the
    # result, you don't interactively attach). --detach forces detach at a TTY.
    wait_mode = bool(getattr(args, "wait", False) or getattr(args, "notify", False))
    detach = bool(args.detach) or wait_mode or (not is_tty)

    # Tracked vs plain (D-Tracked): TTY/human launch => plain; agent/non-TTY OR
    # --wait/--notify => tracked. A seeded prompt at a non-TTY is the agent path.
    tracked = (not is_tty) or wait_mode

    # A bounded Codex worker has no TUI to attach to and its evidence lives in
    # files, so it is ALWAYS tracked and detached — including at a TTY. (amux
    # itself never attaches an exec-mode session either.)
    if codex:
        tracked = True
        detach = True

    abs_dir, parent_name, warning = resolve_dir(args.dir, is_tty)
    if warning:
        _eprint(f"amux-spawn: warning: {warning}")
    if not os.path.isdir(abs_dir):
        _eprint(f"amux-spawn: error: workspace dir does not exist: {abs_dir}")
        return 1

    prefix = lib.workspace_prefix(abs_dir)

    # Assemble the provider flags to forward to amux. Start from the caller's
    # pass-through flags; add inherited --model when the caller gave none.
    #
    # --yolo is forwarded AS ``--yolo`` for both providers: amux expands it once
    # it has resolved the persisted provider (architecture §8 / invariant 3).
    # amux-spawn never spells --dangerously-skip-permissions nor Codex's
    # --dangerously-bypass-approvals-and-sandbox itself.
    forward_flags = list(claude_flags)
    if args.yolo and "--yolo" not in forward_flags and \
            "--dangerously-skip-permissions" not in forward_flags:
        forward_flags.append("--yolo")
    # Model tiers are provider-specific vocabularies: a Claude parent's
    # "--model opus" means nothing to Codex, and BRD §3 requires that a Codex
    # worker with no explicit model falls through to Codex's own config. So the
    # standard --model inheritance is a same-provider (Claude) rule only.
    inh_model = None if codex else inherited_model_flag(forward_flags, parent_name)
    if inh_model:
        forward_flags += ["--model", inh_model]

    # Automated spawns must not read the harness default (epic 21). The non-TTY
    # path IS the agent path, so warn there — never refuse (brd §2.2), never
    # raise (brd §3 H1).
    #
    # Placement is after the inherited-model block above so that a chained
    # opus→opus spawn (which just added --model via inh_model) is correctly seen
    # as pinned and does not cry wolf.
    if not is_tty:
        model_pinned = (lib.extract_model_flag(forward_flags) is not None
                        or bool(os.environ.get("ANTHROPIC_MODEL")))
        # CLAUDE_CODE_EFFORT_LEVEL is deliberately NOT counted as a pin.
        # amux's env allowlist is prefix-based now (ANTHROPIC_*/CLAUDE_*), so
        # the var DOES reach the child — brd §1 finding 5's premise (and brd
        # decision B, keeping it out of the allowlist) is superseded. It is
        # still not a pin because it overrides --effort rather than backing it
        # up (brd §1 finding 6): counting it would silence the warning about
        # the one input that can silently un-pin every per-spawn --effort flag.
        effort_pinned = lib.extract_flag_value(forward_flags, "--effort") is not None
        if not model_pinned:
            _eprint("amux-spawn: warning: non-TTY (agent) spawn pins no model — "
                    "the child reads the harness default, which floats between "
                    "sessions; pass --model <alias>")
        if not effort_pinned:
            _eprint("amux-spawn: warning: non-TTY (agent) spawn pins no effort — "
                    "the child reads the harness default; pass --effort <level>")

    stuck_after_s = parse_stuck_after(args.stuck_after)

    # Build the amux exec base command (E2: --no-default-model so ANTHROPIC_MODEL
    # governs; E5: --no-attach so every spawn is created detached under the lock).
    # The minted --session-id (tracked only) is a valid UUID; amux routes it to
    # meta.json (E4-floor), NOT CC_FLAGS — never re-pass it on restart.
    #
    # Codex mints NOTHING here: --session-id is Claude-only (amux rejects it for
    # other providers), and a fake Codex thread id would be a lie the resume
    # path could act on. The real id arrives in the first ``thread.started``
    # event and amux captures it into <name>.meta.json.
    session_id = lib.mint_uuid() if (tracked and not codex) else None
    run_id = resolve_run_id(args.run_id, parent_name) if tracked else None

    # ── Critical section: one global lock held across cap-check -> name pick ->
    #    create detached -> (tracked) write handle. Released before any attach.
    chosen_name: str
    event_log: str | None = None
    result_path: str | None = None
    with SpawnLock():
        if tracked:
            count = lib.live_tracked_count(abs_dir)
            cap = lib.max_sessions()
            if count >= cap:
                _eprint(
                    f"amux-spawn: refusing to spawn — fork-bomb cap reached: "
                    f"{count}/{cap} live tracked sessions in workspace {abs_dir} "
                    f"(raise AMUX_SPAWN_MAX_SESSIONS to override)."
                )
                return 1

        chosen_name = lib.pick_free_name(prefix, args.suffix)
        # With an explicit suffix the name might already be taken; refuse rather
        # than overwrite an existing session's .env.
        if args.suffix and lib.name_in_use(chosen_name):
            _eprint(
                f"amux-spawn: error: session name already in use: {chosen_name}"
            )
            return 1

        # Codex artifacts are allocated under the SAME lock as the name, so the
        # (name, event log, result) triple is claimed atomically against any
        # concurrent spawn. Nothing has been created outside this repo yet, so a
        # failure here needs no session teardown.
        if codex:
            try:
                event_log, result_path = lib.allocate_codex_artifacts(chosen_name)
            except OSError as exc:
                _eprint(f"amux-spawn: error: {exc}")
                return 1

        # The provider/artifact keywords are supplied ONLY for Codex, so a
        # Claude spawn calls _amux_create_detached with exactly the epic-10
        # keyword set (and the defaults reproduce the epic-10 argv verbatim).
        create_kwargs: dict[str, Any] = {}
        if codex:
            create_kwargs = {
                "provider": provider,
                "event_log": event_log,
                "result_path": result_path,
            }
        rc, detail = _amux_create_detached(
            name=chosen_name,
            abs_dir=abs_dir,
            forward_flags=forward_flags,
            session_id=session_id,
            prompt=prompt,
            **create_kwargs,
        )
        if rc != 0:
            _eprint(f"amux-spawn: error: amux failed to create session {chosen_name}")
            if detail:
                _eprint(detail)
            _rollback_launch(
                name=chosen_name, provider=provider,
                event_log=event_log, result_path=result_path,
                handle_written=False,
            )
            return 1

        # amux runs under `set -e`; don't trust its exit code alone. Confirm the
        # session actually came up before reporting success.
        if not _launch_confirmed(chosen_name, provider, event_log):
            _eprint(
                f"amux-spawn: error: session {chosen_name} did not come up "
                f"(no live tmux session after create)."
            )
            _rollback_launch(
                name=chosen_name, provider=provider,
                event_log=event_log, result_path=result_path,
                handle_written=False,
            )
            return 1

        if tracked:
            if run_id is None or (session_id is None and not codex):
                _eprint("amux-spawn: internal error: missing session_id or run_id for tracked spawn")
                return 1
            # No Claude transcript is guessed for Codex — there is none.
            transcript = None if codex else lib.transcript_path_for(abs_dir, session_id)
            handle = lib.new_handle(
                name=chosen_name,
                session_id=session_id,
                run_id=run_id,
                abs_dir=abs_dir,
                transcript_path=transcript,
                stuck_after_s=stuck_after_s,
                provider=provider,
                activity_path=event_log if codex else None,
                result_path=result_path,
            )
            try:
                lib.write_handle(chosen_name, handle)
            except Exception as exc:  # noqa: BLE001
                _eprint(
                    f"amux-spawn: error: could not write the handle for "
                    f"{chosen_name}: {exc}"
                )
                # delete_handle is idempotent, so claiming the handle exists is
                # the safe assumption even though write_handle is atomic.
                _rollback_launch(
                    name=chosen_name, provider=provider,
                    event_log=event_log, result_path=result_path,
                    handle_written=True,
                )
                return 1
    # ── lock released ──

    # Report the resolved name (to stderr in wait_mode so stdout stays clean for
    # orchestrators capturing the result payload).
    kind = "tracked" if tracked else "plain"
    if wait_mode:
        _eprint(f"amux-spawn: spawned {kind} session '{chosen_name}' in {abs_dir}")
        if session_id:
            _eprint(f"  session_id: {session_id}")
            _eprint(f"  run_id:     {run_id}")
        elif codex:
            _eprint("  provider:   codex (bounded exec)")
            _eprint(f"  run_id:     {run_id}")
    else:
        print(f"amux-spawn: spawned {kind} session '{chosen_name}' in {abs_dir}")
        if tracked and session_id:
            print(f"  session_id: {session_id}")
            print(f"  run_id:     {run_id}")
        elif tracked and codex:
            # No session_id line: the Codex thread id does not exist yet.
            print("  provider:   codex (bounded exec)")
            print(f"  run_id:     {run_id}")
            print(f"  events:     {event_log}")
            print(f"  result:     {result_path}")

    # TTY path: attach / switch-client (separate step, outside the lock). Skipped
    # for --detach / --wait / --notify / non-TTY.
    if not detach:
        _amux_attach(chosen_name)

    # --wait / --notify: block until the seeded turn reaches true idle.
    if wait_mode:
        return _wait_and_report(chosen_name, getattr(args, "timeout", None))

    return 0


def _wait_and_report(name: str, timeout_raw: str | None) -> int:
    """The shared ``--wait`` / ``--notify`` phase (tasks 10-04 + 20-04).

    Blocks until session *name* reaches true idle, then applies the documented
    exit-code/stdout contract: 0 + last_message on success, 3 +
    ``AMUX_WAIT_TIMEOUT`` on caller timeout, 1 + stderr-only detail on error.
    Used verbatim by ``spawn`` and by ``resume`` — the supervision itself is
    provider-dispatched inside :func:`_wait_for_idle`.
    """
    timeout_s = parse_stuck_after(timeout_raw) if timeout_raw else None
    _eprint(f"amux-spawn: waiting for session '{name}' to reach idle"
            + (f" (timeout {timeout_s}s)" if timeout_s else "") + " …")
    outcome, payload = _wait_for_idle(name, timeout_s)
    if outcome == "idle":
        # Stdout = the result payload the orchestrator captures.
        print(payload or "")
        return 0
    elif outcome == "timeout":
        # Machine-readable timeout marker on stdout; distinct exit code 3.
        print(WAIT_TIMEOUT_MARKER)
        _eprint(
            f"amux-spawn: --wait timed out after {timeout_s}s "
            f"(session '{name}' did not reach idle)"
        )
        return 3
    else:
        # Error: detail on stderr, nothing on stdout.
        _eprint(f"amux-spawn: --wait error: {payload}")
        return 1


def _amux_create_detached(
    *,
    name: str,
    abs_dir: str,
    forward_flags: list[str],
    session_id: str | None,
    prompt: str | None,
    provider: str = lib.PROVIDER_CLAUDE,
    event_log: str | None = None,
    result_path: str | None = None,
) -> tuple[int, str | None]:
    """Create the session detached, through amux's PUBLIC option contract.

    Claude (unchanged epic-10 argv)::

        amux exec <name> --no-attach --no-default-model --dir <dir>
             [--session-id <uuid>] [flags…] [prompt]

    Codex bounded worker (amux `docs/codex-provider.md` §§2–3)::

        amux exec <name> --no-attach --provider codex --agent-mode exec
             --dir <dir> --event-log <E> --output-last-message <R>
             [flags…] -- <prompt>

    ``--provider`` / ``--agent-mode`` / ``--event-log`` /
    ``--output-last-message`` are amux's provider-neutral options: amux persists
    them to ``<name>.env`` (``CC_PROVIDER`` / ``CC_AGENT_MODE`` /
    ``CC_EVENT_LOG`` / ``CC_LAST_MESSAGE``) and builds ``codex exec --json -C
    <dir> -o <R> …`` itself. This function constructs **no** provider argv and
    injects no model, sandbox or approval flag; ``--yolo`` rides along untouched
    for amux to expand after provider resolution (invariant 3).

    ``--no-default-model`` and ``--session-id`` are Claude-only (amux refuses
    them for any other provider), so the Codex form carries neither.

    The prompt is one argv element on both paths. For the bounded path it is
    preceded by amux's documented ``--`` separator (``amux start w -- "…"``),
    which ``cmd_start`` strips before handing the prompt to Codex — so the
    prompt keeps its argv boundary and nothing in it is expanded or executed.

    Returns ``(returncode, captured_output_or_none)``.
    """
    cmd: list[str] = ["amux", "exec", name, "--no-attach"]  # E5: create detached
    if provider == lib.PROVIDER_CODEX:
        cmd += [
            "--provider", lib.PROVIDER_CODEX,
            "--agent-mode", "exec",
            "--dir", abs_dir,
        ]
        if event_log is not None:
            cmd += ["--event-log", event_log]
        if result_path is not None:
            cmd += ["--output-last-message", result_path]
        cmd += forward_flags
        if prompt is not None:
            cmd += ["--", prompt]
    else:
        cmd += [
            "--no-default-model",   # E2: let ANTHROPIC_MODEL / our --model govern
            "--dir", abs_dir,
        ]
        if session_id is not None:
            cmd += ["--session-id", session_id]
        cmd += forward_flags
        if prompt is not None:
            # Trailing positional => claude prompt (auto-submits). amux's flag
            # parser sends unrecognized tokens to CC_EXTRA_ARGS == the prompt.
            # Pass it as a single argv element so multi-word/multi-line prompts
            # stay intact.
            cmd.append(prompt)

    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            # Pass our live environment through so amux's update-environment
            # allowlist (E1) can copy the model/auth vars into the child pane.
            env=os.environ.copy(),
        )
    except Exception as exc:  # noqa: BLE001
        return 1, f"amux invocation failed: {exc}"
    out = (result.stdout or "") + (result.stderr or "")
    return result.returncode, out.strip() or None


def _launch_confirmed(name: str, provider: str, event_log: str | None) -> bool:
    """Did the session actually come up? (amux runs under ``set -e``.)

    Claude: unchanged — a live tmux session is the signal.

    Codex bounded: liveness is NOT the signal. A bounded ``codex exec`` run is
    expected to exit on its own, and a trivial turn can be over before this
    check runs — so completion evidence beats liveness (architecture §5). The
    ``.rc`` sibling (written by amux's launch wrapper when the run finishes) or
    any event byte proves the pane really started.
    """
    if lib.tmux_has_session(name):
        return True
    if provider != lib.PROVIDER_CODEX or not event_log:
        return False
    try:
        if os.path.exists(f"{event_log}.rc"):
            return True
        return os.path.getsize(event_log) > 0
    except OSError:
        return False


def _rollback_launch(
    *,
    name: str,
    provider: str,
    event_log: str | None,
    result_path: str | None,
    handle_written: bool,
) -> None:
    """Undo a partially completed Codex launch (task 20-02 work item 7).

    Order matters, and it is the reverse of creation:

      1. the handle first — while it exists, a reader can see a tracked session
         pointing at something that is about to be destroyed;
      2. then ``amux rm``, which stops tmux (``kill-session``, never SIGKILL —
         01-01 evidence) and removes the registration + ``<name>.meta.json``;
      3. then the artifacts, once nothing can still be writing to them.

    Claude launches keep their epic-10 failure behavior byte-for-byte: this is a
    no-op for them (a Claude session left behind by a failed create is
    pre-existing behavior and out of this task's scope). Everything here is
    fail-soft — rollback never turns one failure into two.
    """
    if provider != lib.PROVIDER_CODEX:
        return
    if handle_written:
        lib.delete_handle(name)
    _amux_rm(name)
    lib.remove_codex_artifacts(event_log, result_path)


# ── Resume: the next bounded Codex turn (task 20-04) ──────────────────────────
#
# Architecture §7's coordinated order, mapped onto the amux contract at the
# pinned revision:
#
#   1. acquire the normal spawn/session lock (the SAME one spawn/remove take,
#      so resume is serialized against both);
#   2. require provider=codex, an idle/terminated process, and a valid
#      captured thread id (amux's meta.json — never minted here);
#   3. the "next event artifact segment" is amux's own: `amux start --resume`
#      re-reads the persisted --event-log and APPENDS the new segment to it
#      (docs/codex-provider.md §4: "appended, never truncated"). Nothing is
#      rotated or truncated on this side, so prior evidence survives by
#      construction;
#   4. ask amux to launch `codex exec resume <thread-id> <prompt>` (it builds
#      the argv, validates the id as a UUID, and quarantines a foreign
#      thread.started to `.err` with `.rc` = 66);
#   5. update the handle attempt ATOMICALLY, only after the launch succeeds.
#
# A failed launch preserves the previous result and evidence: the handle is
# never written, the event log was never truncated, and amux's pre-launch
# exit-status removal is undone from a snapshot.

# Options codex-cli 0.149.0 rejects on `codex exec resume` (spike evidence,
# docs/codex-provider.md §3). amux dies with guidance for the full list; these
# are the ones amux-spawn refuses up front with its own actionable message so
# the caller never reaches a doomed launch. Never silently dropped.
CODEX_RESUME_REJECTED_FLAGS = ("-p", "--profile", "-C", "--cd", "-s", "--sandbox")


def _amux_start_resume(
    name: str,
    forward_flags: list[str],
    prompt: str,
) -> tuple[int, str | None]:
    """Launch the next bounded turn through amux's PUBLIC resume contract.

    ``amux start <name> --resume --no-attach [flags…] -- <prompt>`` —
    ``--resume`` must be amux's FIRST option after the session name. amux
    re-reads provider/mode/artifact paths from the session's persisted env
    (they cannot be re-set on start), validates the stored thread id as a
    UUID before launching, appends the new segment to the SAME event log and
    arms its fail-closed ``--expect-thread`` comparison. No provider argv is
    constructed here (cross-task invariant 3).

    Returns ``(returncode, captured_output_or_none)``.
    """
    cmd = ["amux", "start", name, "--resume", "--no-attach"]
    cmd += list(forward_flags)
    cmd += ["--", prompt]
    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            env=os.environ.copy(),
        )
    except Exception as exc:  # noqa: BLE001
        return 1, f"amux invocation failed: {exc}"
    out = (result.stdout or "") + (result.stderr or "")
    return result.returncode, out.strip() or None


def _snapshot_rc(event_log: str | None) -> bytes | None:
    """Bytes of ``<event_log>.rc`` if present — amux removes it at launch."""
    if not event_log:
        return None
    try:
        with open(f"{event_log}.rc", "rb") as f:
            return f.read()
    except OSError:
        return None


def _restore_rc(event_log: str | None, snapshot: bytes | None) -> None:
    """Restore a snapshotted exit-status file after a failed resume launch.

    amux deletes ``.rc`` at launch so its absence always refers to the current
    attempt (docs/codex-provider.md §4); a launch that never started a turn
    must not leave that hole in the previous attempt's readable state. An
    absent snapshot stays absent — a ``.rc`` written by the failed launch
    itself is evidence of it, not noise. Fail-soft.
    """
    if not event_log or snapshot is None:
        return
    try:
        with open(f"{event_log}.rc", "wb") as f:
            f.write(snapshot)
    except OSError:
        pass


def cmd_resume(args: argparse.Namespace, forward_flags: list[str], prompt: str | None) -> int:
    """``resume <handle> -- "prompt"`` — start the next bounded Codex turn.

    The resumed run continues the EXACT captured Codex thread: the id comes
    from amux's authoritative ``meta.json`` (cross-checked against the event
    artifact and the handle), must parse as a UUID, and is never minted,
    guessed or defaulted — a missing or malformed id is a hard error and no
    process is started (BRD §4.3: it must never start a fresh, unrelated
    conversation under the old handle).
    """
    name = (getattr(args, "handle", "") or "").strip()
    if not name:
        _eprint("amux-spawn resume: missing <handle>")
        return 2
    if prompt is None:
        _eprint(
            "amux-spawn: error: resume needs a prompt: a resumed bounded run "
            "is one more seeded turn.\n"
            "  amux-spawn resume <handle> -- \"address the remaining issue\""
        )
        return 1

    # Refusals BEFORE anything is locked, read or launched. A flag that
    # cannot ride a resume errors with guidance — it is never silently
    # dropped and never forwarded to a doomed launch.
    for flag in CLAUDE_ONLY_PERMISSION_FLAGS:
        if _flag_present(forward_flags, flag):
            _eprint(
                f"amux-spawn: error: {flag} is a Claude flag and must never "
                f"reach Codex.\n"
                "  Use --yolo at spawn time: amux expands it per provider."
            )
            return 1
    if getattr(args, "yolo", False) or _flag_present(forward_flags, "--yolo"):
        _eprint(
            "amux-spawn: error: --yolo cannot be set on resume. It is a "
            "registration-time choice, persisted with the session and "
            "inherited by every resumed run; forwarding it here would hand "
            "Codex a flag it does not know.\n"
            "  Spawn a new worker with (or without) --yolo to change it."
        )
        return 1
    if getattr(args, "profile", None):
        _eprint(
            "amux-spawn: error: --profile cannot ride a resume.\n"
            "  amux-spawn's --profile is a Claude ~/.claude/profiles.toml "
            "concept, and Codex's own -p/--profile is rejected by "
            "`codex exec resume` (codex-cli 0.149.0).\n"
            "  Configure ~/.codex/config.toml for Codex defaults, or pass an "
            "explicit --model=<name> (resume accepts -m/--model)."
        )
        return 1
    for bad in CODEX_RESUME_REJECTED_FLAGS:
        if _flag_present(forward_flags, bad):
            _eprint(
                f"amux-spawn: error: {bad} cannot ride a resume — "
                f"`codex exec resume` rejects it (codex-cli 0.149.0) and a "
                f"resumed run keeps the session's workspace.\n"
                "  Re-spawn a fresh worker to change the working directory or "
                "sandbox; see amux resume guidance for details."
            )
            return 1
    if getattr(args, "dir", None):
        _eprint(
            "amux-spawn: error: --dir cannot be changed on resume: the "
            "resumed run keeps the workspace the session was spawned with "
            "(its dir is persisted by amux)."
        )
        return 1

    wait_mode = bool(getattr(args, "wait", False) or getattr(args, "notify", False))
    json_out = bool(getattr(args, "json", False))

    event_log: str | None = None
    thread_id: str | None = None
    new_attempt = 0
    with SpawnLock():
        handle = lib.read_handle(name)
        if handle is None:
            _eprint(f"amux-spawn resume: no tracked handle found for '{name}'")
            return 1
        if not lib.is_codex_handle(handle):
            _eprint(
                f"amux-spawn: error: resume is a Codex-thread operation; "
                f"handle '{name}' is provider="
                f"{lib.handle_provider(handle)!r}.\n"
                "  Claude sessions continue interactively "
                "(amux-spawn a|attach <suffix>) or via a new spawn; there is "
                "no bounded-turn resume for them."
            )
            return 1

        # §7 step 2: an idle/terminated process only. A live attempt —
        # running, stuck, or a resume whose handle bump has not been followed
        # by its first event yet (spawning) — is refused. Holding the spawn
        # lock across this check is what rejects a concurrent second resume
        # of the same handle (and serializes against spawn/remove).
        try:
            state = _derive_status(handle, None).get("state", "unknown")
        except Exception:  # noqa: BLE001
            state = "unknown"
        if state not in ("idle", "terminated"):
            _eprint(
                f"amux-spawn: error: session '{name}' is {state} — refusing "
                f"to resume a live attempt. Wait for the current turn "
                f"(amux-spawn status {name}) or reap it first "
                f"(amux-spawn rm {name} --force)."
            )
            return 1

        # Thread-id authority (BRD §4.3 / amux docs §5): amux's captured id,
        # validated as a UUID here — belt-and-suspenders alongside amux's own
        # pre-launch guard. Missing or malformed => hard error, no launch.
        thread_id = lib.read_codex_thread_id(name)
        if not thread_id:
            _eprint(
                f"amux-spawn: error: no captured Codex thread id for session "
                f"'{name}' (amux's {lib.meta_path(name)}, key "
                f"'{lib.CODEX_THREAD_KEY}'). The first bounded turn captures "
                f"it — run one before resuming. A missing id NEVER falls "
                f"back to a fresh thread."
            )
            return 1
        if not lib.is_uuid_string(thread_id):
            _eprint(
                f"amux-spawn: error: malformed Codex thread id for session "
                f"'{name}': {thread_id!r}. Codex would treat a non-UUID id "
                f"as a thread NAME and silently start an unrelated new "
                f"conversation — refusing to resume. Fix or clear the id in "
                f"{lib.meta_path(name)}."
            )
            return 1

        # Cross-check the authoritative id against the captured evidence: a
        # disagreement means corrupted state, and resuming would target a
        # thread these artifacts do not describe. Fail closed.
        reduction = _codex_reduce(handle, process_gone=not lib.tmux_has_session(name))
        artifact_id = reduction.get("thread_id")
        stored_id = handle.get("session_id")
        for source, value in (("event artifact", artifact_id), ("handle", stored_id)):
            if isinstance(value, str) and value and value != thread_id:
                _eprint(
                    f"amux-spawn: error: corrupted thread identity for "
                    f"'{name}': amux meta.json says {thread_id!r} but the "
                    f"{source} says {value!r}. Refusing to resume a thread "
                    f"the evidence does not describe — inspect "
                    f"{lib.meta_path(name)} and the event artifact."
                )
                return 1

        # Prior readable state to preserve if the launch fails (work item 4):
        # amux removes `.rc` at launch; snapshot it for restore. The event
        # log is append-only and the result file is only written by Codex on
        # success, so those need no snapshot.
        event_log = handle.get("activity_path")
        base_attempt = max(_handle_attempt(handle), int(reduction.get("segments") or 0))
        rc_snapshot = _snapshot_rc(event_log)

        rc, detail = _amux_start_resume(name, forward_flags, prompt)
        if rc != 0:
            _eprint(f"amux-spawn: error: amux failed to resume session {name}")
            if detail:
                _eprint(detail)
            _restore_rc(event_log, rc_snapshot)
            return 1
        if not _launch_confirmed(name, lib.PROVIDER_CODEX, event_log):
            _eprint(
                f"amux-spawn: error: session {name} did not come up after "
                f"resume (no live tmux session, exit status or new events)."
            )
            _restore_rc(event_log, rc_snapshot)
            return 1

        # §7 step 5: the ONLY handle write, atomically, after a successful
        # launch. The attempt bump is the cross-segment key readers use; the
        # state flip keeps the in-flight attempt from false-reading idle off
        # the previous attempt's completion.
        new_attempt = base_attempt + 1
        handle["attempt"] = new_attempt
        handle["session_id"] = thread_id
        handle["state"] = "spawning"
        handle["updated_at"] = lib.iso_now()
        try:
            lib.write_handle(name, handle)
        except Exception as exc:  # noqa: BLE001
            _eprint(
                f"amux-spawn: error: could not update the handle for "
                f"{name}: {exc}\n"
                f"  the resumed worker is running and its evidence is intact; "
                f"the attempt counter was not bumped."
            )
            return 1
    # ── lock released ──

    if json_out:
        payload = json.dumps({
            "name": name,
            "provider": lib.PROVIDER_CODEX,
            "state": "spawning",
            "attempt": new_attempt,
            "thread_id": thread_id,
            "events": event_log,
            "result": handle.get("result_path"),
        })
        if wait_mode:
            _eprint(payload)
        else:
            print(payload)
    else:
        banner = (
            f"amux-spawn: resumed session '{name}' (attempt {new_attempt}) "
            f"on thread {thread_id}"
        )
        detail = f"  events:     {event_log}\n  result:     {handle.get('result_path')}"
        if wait_mode:
            # Stdout stays clean for the orchestrator's result payload.
            _eprint(banner)
            _eprint(detail)
        else:
            print(banner)
            print(detail)

    if wait_mode:
        return _wait_and_report(name, getattr(args, "timeout", None))
    return 0


def _amux_attach(name: str) -> None:
    """Attach / switch-client to the session (TTY path).

    Delegates to ``amux attach``, which already does switch-client inside tmux
    (E3) and attach-session otherwise. This blocks until the human detaches — it
    runs only AFTER the spawn lock is released.
    """
    try:
        os.execvp("amux", ["amux", "attach", name])
    except Exception as exc:  # noqa: BLE001
        _eprint(f"amux-spawn: warning: could not attach to {name}: {exc}")


# ── Supervise: --wait / --notify (task 10-04) ─────────────────────────────────
#
# Exit-code contract (distinct, machine-readable):
#   0  -> true idle reached; last_message printed to stdout.
#   1  -> error (session terminated before idle, or poll error).
#   3  -> timeout expired before idle (caller's patience, NOT a stuck signal).
#
# Stdout contract (for orchestrators):
#   On success (exit 0): the session's last_message (or an empty string if none).
#   On timeout (exit 3): the single line ``AMUX_WAIT_TIMEOUT`` (machine-readable
#     marker), so an orchestrator can reliably distinguish timeout from success.
#   On error (exit 1):  nothing to stdout (error detail on stderr).
#
# --notify is an alias of --wait (same blocking semantics). The pattern for
# asynchronous notification is: run `amux-spawn spawn … --wait` (or --notify)
# as a background Bash task (`run_in_background`). The harness emits its native
# completion notification when the background task finishes, and the orchestrator
# reads the output-file for the result. --wait's stdout IS the payload.
#
# False-idle guard (FR5 / architecture §6 step 2):
#   A freshly-created session has state=spawning / mtime_at_stop=None, which the
#   _derive_status logic already maps to "running" (not "idle") via the
#   no_stop_yet clause. We add a belt-and-suspenders flag ``seen_non_idle`` that
#   requires the poll to have observed at least one "running" or "stuck" state
#   (i.e. the seeded turn started) before we accept "idle". A session whose
#   handle is still in spawning state can never satisfy --wait.

# Sentinel printed to stdout on timeout (exit 3). Keep it machine-parseable and
# distinct from any real last_message content (all-caps, no spaces, not natural
# language).
WAIT_TIMEOUT_MARKER = "AMUX_WAIT_TIMEOUT"

# Poll interval while --wait is active (seconds). Low enough to be responsive
# (~1s after an idle Stop fires), high enough not to busy-spin on fast hardware.
WAIT_POLL_INTERVAL_S = 0.75


def _wait_for_idle(
    name: str,
    timeout_s: float | None,
) -> tuple[str, str | None]:
    """Block until the session ``name`` reaches true idle, or until timeout.

    Uses the SAME ``_derive_status`` derivation as ``status`` (in-process, no
    subprocess). Polls at ``WAIT_POLL_INTERVAL_S`` intervals.

    Returns ``(outcome, payload)`` where:
      outcome == "idle"    -> payload == last_message (str or "")
      outcome == "timeout" -> payload == None
      outcome == "error"   -> payload == error description (str)

    False-idle guard (Claude): requires seeing at least one non-idle state
    (running or stuck) before accepting idle. A session still in spawning / with
    no Stop yet will read "running" (active, no_stop_yet) so the first iteration
    is never mistakenly "idle" — but we enforce this explicitly as a
    belt-and-suspenders guard (architecture §6 step 2 / FR5).

    Codex (task 20-03): completion evidence (``turn.completed``) is itself proof
    the seeded turn ran, so the false-idle gate does not apply — a bounded turn
    can legitimately finish between two polls. The idle payload is the
    final-message artifact, not a hook-written ``last_message``. And
    ``terminated`` is never latched on first observation: the 01-01 spike
    showed the forked codex child appending ``turn.completed`` up to ~10 s
    after the tmux session died (exit 137 + completion coexist), so the
    artifact is re-checked for :data:`CODEX_ORPHAN_GRACE_S` before the wait
    gives up (the caller's deadline still wins — expiry mid-grace is a
    timeout, exit 3, not an error).

    Codex idle acceptance additionally requires the run's file writes to be
    FINAL (sign-off finding F1): ``turn.completed`` is flushed to the event log
    before codex writes the final-message artifact, and amux's wrapper writes
    the ``.rc`` sibling only after codex exits — so a poll can observe true
    idle while the result file is still empty (first attempt) or still holds
    the previous attempt's text (after a resume). An idle with no ``.rc`` yet
    is re-polled for :data:`CODEX_RESULT_GRACE_S` and then accepted fail-open:
    completion evidence beats the artifact (architecture §5), and the stdout
    contract already documents "or an empty string if none". The payload itself
    is derived by :func:`_final_message` — the SAME read path ``last`` uses.
    """
    deadline: float | None = (time.time() + timeout_s) if timeout_s is not None else None

    # Belt-and-suspenders false-idle guard: require at least one non-idle
    # observation (running or stuck) before we accept "idle". This ensures the
    # seeded turn has started.
    seen_non_idle = False

    # Codex orphan re-check: when the derived state first reads "terminated".
    terminated_since: float | None = None

    # Codex result-lag re-check: when idle is first seen without the run's
    # writes being final (no ``.rc`` sibling yet).
    result_lag_since: float | None = None

    while True:
        # Check timeout BEFORE polling so a zero-timeout returns immediately.
        if deadline is not None and time.time() >= deadline:
            return "timeout", None

        # Re-read the handle fresh on every poll (the producer hook overwrites it
        # on every Stop — this is what carries state/last_message/mtime_at_stop;
        # for Codex it stays as-written and the artifacts carry the lifecycle).
        handle = lib.read_handle(name)
        if handle is None:
            return "error", f"handle for session '{name}' disappeared during wait"

        try:
            result = _derive_status(handle, None)
        except Exception as exc:  # noqa: BLE001
            return "error", f"_derive_status raised: {exc}"

        state = result.get("state", "unknown")
        codex = lib.is_codex_handle(handle)

        if state == "terminated":
            result_lag_since = None
            if not codex:
                return "error", f"session '{name}' terminated before reaching idle"
            # Re-check the artifact instead of latching the first "gone"
            # observation: the orphan child may still be completing the turn.
            now = time.time()
            if terminated_since is None:
                terminated_since = now
            if now - terminated_since >= CODEX_ORPHAN_GRACE_S:
                summary = _codex_failure_summary(result)
                message = f"session '{name}' terminated before reaching idle"
                return "error", f"{message} ({summary})" if summary else message
            # Inside the grace window — fall through and poll again.
        else:
            terminated_since = None
            if state in ("running", "stuck"):
                seen_non_idle = True

            if state == "idle" and (codex or seen_non_idle):
                if not codex:
                    # True idle: a Stop with empty background_tasks, after the
                    # seeded turn ran (seen_non_idle gate). Claude's payload is
                    # the producer hook's last_message — byte-identical to the
                    # pre-F1 behavior, via the shared derivation.
                    return "idle", _final_message(handle) or ""
                # Codex true idle: the NEWEST segment's turn.completed is in the
                # event artifact. Accept only once the run's writes are final —
                # a present .rc sibling means codex exited, and codex writes
                # the final-message artifact before exiting (F1).
                signals = result.get("signals") or {}
                if signals.get("exit_code_present"):
                    return "idle", _final_message(handle) or ""
                now = time.time()
                if result_lag_since is None:
                    result_lag_since = now
                elif now - result_lag_since >= CODEX_RESULT_GRACE_S:
                    # Fail-open: completion evidence beats the artifact (§5).
                    # Print whatever the shared reader gives — possibly "" per
                    # the documented stdout contract.
                    return "idle", _final_message(handle) or ""
                # Writes still in flight — fall through and poll again.
            else:
                result_lag_since = None

        # Not yet idle (or idle but haven't seen a non-idle intermediate) — keep
        # waiting.
        sleep_s = WAIT_POLL_INTERVAL_S
        if deadline is not None:
            remaining = deadline - time.time()
            if remaining <= 0:
                return "timeout", None
            sleep_s = min(sleep_s, remaining)
        time.sleep(sleep_s)


# ── helpers ───────────────────────────────────────────────────────────────────

def parse_stuck_after(raw: str | None) -> int:
    """Parse ``--stuck-after`` (e.g. ``10m``, ``600``, ``2h``) into seconds."""
    if not raw:
        return lib.DEFAULT_STUCK_AFTER_S
    raw = raw.strip().lower()
    mult = 1
    if raw.endswith("s"):
        raw = raw[:-1]
    elif raw.endswith("m"):
        raw = raw[:-1]
        mult = 60
    elif raw.endswith("h"):
        raw = raw[:-1]
        mult = 3600
    try:
        return max(1, int(float(raw) * mult))
    except ValueError:
        return lib.DEFAULT_STUCK_AFTER_S


# ── Reads: status / last / ls (task 10-03) ────────────────────────────────────
#
# State is DERIVED at read time (architecture §6 / §6.0 never stores `stuck`).
# Precedence: terminated -> stuck -> running -> idle. Reason-context is best-effort
# and ADDITIVE — every signal found is listed; the cause is never inferred into the
# state. All reads are fail-soft: a missing/partial handle yields a best-effort /
# "unknown" result, never a traceback.


def _import_permission_store() -> Any:
    """Import ``permission_state_store`` if reachable, else None (fail-soft).

    Lives alongside the hooks; reuse ``get_pending_request_for_session`` for the
    precise session_id↔permission match (the store keys by session_id).
    """
    try:
        import permission_state_store as store  # type: ignore
        return store
    except Exception:  # noqa: BLE001
        return None


def _live_background_tasks(handle: dict[str, Any]) -> list[dict[str, Any]]:
    """Background-task entries from the handle that are not in a terminal status.

    The handle self-drains to ``[]`` on a completion ``Stop`` (architecture §2.2),
    so this is normally just ``handle["background_tasks"]``. As a defensive guard
    (architecture §6 step 2) we drop entries whose status looks terminal.
    """
    tasks = handle.get("background_tasks")
    if not isinstance(tasks, list):
        return []
    live: list[dict[str, Any]] = []
    for t in tasks:
        if not isinstance(t, dict):
            continue
        status = str(t.get("status", "")).lower()
        if status in ("completed", "done", "failed", "cancelled", "canceled", "error", "killed"):
            continue
        live.append(t)
    return live


def _reason_context(handle: dict[str, Any]) -> dict[str, Any]:
    """Assemble cause-agnostic reason-context from files (architecture §7).

    BEST-EFFORT and ADDITIVE — lists EVERY signal found; never collapses to one
    cause. Returns a dict with keys: ``background_tasks`` (list), ``foreground_tool``
    (dict|None), ``pending_permission`` (dict|None). Empty/None where not found.
    """
    transcript_path = handle.get("transcript_path")

    # 1) Background work: handle entries + harness task output files (bounded tail).
    background: list[dict[str, Any]] = []
    tasks_dir = lib.session_tasks_dir(transcript_path)
    for t in _live_background_tasks(handle):
        if not isinstance(t, dict):
            continue
        task_id = str(t.get("id", "")) if t.get("id") is not None else ""
        ctx: dict[str, Any] = {
            "kind": t.get("type"),
            "id": t.get("id"),
            "command": t.get("command") or t.get("label") or t.get("description"),
            "status": t.get("status"),
            "started_at": t.get("started_at"),
            "pid": t.get("pid"),
        }
        out = lib.read_task_output_tail(tasks_dir, task_id) if task_id else None
        if out:
            ctx["output_file"] = out["output_file"]
            ctx["output_tail"] = out["tail"]
            ctx["output_mtime"] = out["mtime"]
        background.append(ctx)

    # 2) In-flight foreground tool: a tool_use with no result + frozen mtime (age).
    foreground = None
    fg = lib.inflight_foreground_tool(transcript_path)
    if fg:
        mtime = lib.transcript_mtime(transcript_path)
        foreground = dict(fg)
        if mtime is not None:
            foreground["age_s"] = round(max(0.0, time.time() - mtime), 1)

    # 3) Pending permission: matched PRECISELY by session_id via the store.
    pending_permission = None
    session_id = handle.get("session_id")
    store = _import_permission_store()
    if store is not None and isinstance(session_id, str) and session_id:
        try:
            req = store.get_pending_request_for_session(session_id)
        except Exception:  # noqa: BLE001
            req = None
        if req is not None:
            pending_permission = {
                "request_id": getattr(req, "request_id", None),
                "tool_name": getattr(req, "tool_name", None),
                "tool_input": getattr(req, "tool_input", None),
                "created_at": getattr(req, "created_at", None),
            }

    return {
        "background_tasks": background,
        "foreground_tool": foreground,
        "pending_permission": pending_permission,
    }


# ── Codex state derivation (task 20-03) ───────────────────────────────────────
#
# Epic-20 architecture §5 is the binding precedence, implemented directly:
#
#   turn.completed (last-wins, no turn.failed) -> idle   — REGARDLESS of exit
#     code; a SIGKILLed parent (exit 137) whose orphan child finished the turn
#     is a completed run, and exit 0 without turn.completed (the SIGTERM trap)
#     is NOT.
#   turn.failed (last-wins)                   -> terminated — regardless of exit
#     code.
#   tmux alive, activity too old               -> stuck     (never persisted).
#   tmux alive                                 -> running (or spawning before
#     the first thread.started event).
#   process gone, no completion evidence and no explicit failure -> terminated,
#     with the exit code carried as REASON CONTEXT only.
#
# Liveness is the tmux session (amux owns the pane; ``process_pid`` stays a
# best-effort nullable field nobody populates today). Activity is the event
# artifact's mtime, falling back to handle ``created_at``. No signal ever comes
# from terminal-pane text (epic invariant 5 / BRD §4.2).

# 01-01 spike evidence: ``codex exec`` forks a child that survives a bare
# ``kill -9`` on the parent and can append ``turn.completed`` (and write the
# result file) up to ~10 s AFTER the tmux session is gone. ``--wait`` must
# therefore re-check the artifact for this long before latching "terminated".
CODEX_ORPHAN_GRACE_S = 10.0

# Same evidence family, other direction: ``turn.completed`` is flushed to the
# event log BEFORE codex writes the ``--output-last-message`` file (written at
# exec end), and amux's wrapper writes the ``.rc`` sibling only after codex
# exits — so ``--wait`` can observe true idle while the final-message artifact
# is still in flight (empty on a first attempt, the previous attempt's text
# after a resume — sign-off finding F1). Re-poll for this long for the run's
# writes to become final before printing; after that, fail open.
CODEX_RESULT_GRACE_S = 10.0

# Normalized Codex failure reasons (task 20-03 work item 6). The terminated
# ones come straight out of the reducer; the three below are derived here.
CODEX_REASON_STALE_ACTIVITY = "stale_activity"          # alive but silent
CODEX_REASON_MALFORMED_COMPLETION = "malformed_completion"  # completed, no readable result
CODEX_REASON_THREAD_MISMATCH = "thread_mismatch"        # amux's fail-closed quarantine

# amux's documented exit status when a resumed run's first ``thread.started``
# id did NOT echo the requested one: the foreign output is quarantined to
# ``<event-log>.err`` and the child is SIGINTed (docs/codex-provider.md §5).
# Surfaced here as a normalized failure reason — never re-derived here.
CODEX_EXIT_THREAD_MISMATCH = 66


def _codex_reduce(handle: dict[str, Any], *, process_gone: bool,
                  read_result: bool = False) -> dict[str, Any]:
    """Reduce a Codex handle's artifacts, fail-open on any error."""
    if codex_reducer is None:
        return {"activity_mtime": None, "thread_id": None, "thread_started": False,
                "turn_started": False, "turn_completed": False, "turn_failed": False,
                "segments": 0, "exit_code": None, "exit_code_present": False,
                "result_available": False, "result_text": None, "outcome": None,
                "state_hint": None, "failure": None, "result_path": None,
                "refused_path": False}
    try:
        return codex_reducer.reduce_handle(
            handle, process_gone=process_gone, read_result=read_result
        )
    except Exception:  # noqa: BLE001
        return codex_reducer.empty_reduction()


def _codex_result_text(handle: dict[str, Any]) -> str | None:
    """The bounded final-message artifact's text (or None), size-limited."""
    if codex_reducer is None:
        return None
    try:
        return codex_reducer.read_result_text(handle.get("result_path"))
    except Exception:  # noqa: BLE001
        return None


def _final_message(handle: dict[str, Any]) -> str | None:
    """The message ``last`` prints for this handle — ONE derivation, two callers.

    Codex: the bounded final-message artifact via the reducer's reader (the
    newest successful turn's text). Claude: the producer hook's
    ``last_message`` handle field. ``cmd_last`` and the ``--wait`` completion
    print both go through here so the two surfaces can never diverge again
    (sign-off finding F1 shipped exactly such a divergence).
    """
    if lib.is_codex_handle(handle):
        return _codex_result_text(handle)
    return handle.get("last_message")


def _codex_failure_summary(result: dict[str, Any]) -> str | None:
    """One-line normalized failure summary out of a derivation result."""
    failure = result.get("failure")
    if not isinstance(failure, dict):
        return None
    bits = [str(failure.get("reason") or "unknown")]
    if failure.get("exit_code") is not None:
        bits.append(f"exit {failure['exit_code']}")
    message = failure.get("message")
    if isinstance(message, str) and message.strip():
        bits.append(message.strip())
    return ": ".join(bits)


def _handle_attempt(handle: dict[str, Any]) -> int:
    """The handle's launch-attempt counter, defaulting to 1 (>= 1 always).

    Legacy Codex handles (pre-20-04) have no ``attempt`` key; callers combine
    this with the reducer's segment count via max().
    """
    try:
        value = int(handle.get("attempt") or 1)
    except (TypeError, ValueError):
        return 1
    return max(1, value)


def _derive_codex_status(handle: dict[str, Any], stuck_after_override: int | None) -> dict[str, Any]:
    """Derive a bounded Codex worker's state (architecture §5 precedence).

    Attempt semantics (task 20-04): the handle's ``attempt`` counts launches;
    the artifact's ``thread.started`` count (``segments``) counts turns whose
    evidence has started arriving. The reported attempt is the max of the two.
    While ``attempt > segments`` an attempt is IN FLIGHT whose segment has not
    started — the artifact's last turn outcome then belongs to an OLDER
    attempt and must not mask the live/dead question for the newest one (a
    freshly resumed worker would otherwise false-read ``idle`` off the previous
    attempt's ``turn.completed`` until the new segment's first event lands).
    """
    name = str(handle.get("name", ""))

    stuck_after = stuck_after_override
    if stuck_after is None:
        try:
            stuck_after = int(handle.get("stuck_after_s") or lib.DEFAULT_STUCK_AFTER_S)
        except (TypeError, ValueError):
            stuck_after = lib.DEFAULT_STUCK_AFTER_S

    alive = lib.tmux_has_session(name) if name else False
    reduction = _codex_reduce(handle, process_gone=not alive)

    segments = int(reduction.get("segments") or 0)
    handle_attempt = _handle_attempt(handle)
    attempt = max(handle_attempt, segments)
    # An attempt was launched (handle bumped under the resume lock) but its
    # segment has not started: no Nth thread.started in the artifact yet.
    # The gate matters only when an OLDER segment exists to mask it — a fresh
    # spawn (attempt 1, empty artifact) has no prior turn.completed that could
    # false-read idle, and keeps the plain §5 liveness/age derivation.
    attempt_pending = handle_attempt > segments and segments > 0

    result: dict[str, Any] = {
        "name": name,
        "provider": lib.PROVIDER_CODEX,
        "stored_state": handle.get("state"),
        "active": alive,
        "stuck_after_s": stuck_after,
        "thread_id": reduction.get("thread_id") or handle.get("session_id"),
        "attempt": attempt,
        "exit_code": reduction.get("exit_code"),
        "result_path": handle.get("result_path"),
        "signals": {
            "tmux_alive": alive,
            "thread_started": bool(reduction.get("thread_started")),
            "turn_started": bool(reduction.get("turn_started")),
            "turn_completed": bool(reduction.get("turn_completed")),
            "turn_failed": bool(reduction.get("turn_failed")),
            "exit_code_present": bool(reduction.get("exit_code_present")),
            "result_available": bool(reduction.get("result_available")),
            "refused_path": bool(reduction.get("refused_path")),
            "attempt_pending": attempt_pending,
        },
    }

    if attempt_pending:
        # The newest attempt owns the state; the artifact's last-wins outcome
        # is stale (older attempt). Its activity clock is the resume launch
        # time (handle updated_at), NOT the artifact mtime — which the new
        # attempt has not touched yet.
        return _derive_pending_attempt(result, reduction, handle, alive, attempt)

    # §5 precedence, in order. The reducer already resolved last-wins turn
    # outcomes across appended resume segments, so its state_hint IS the
    # authoritative verdict for the first two rows.
    state_hint = reduction.get("state_hint")

    if state_hint == "idle":
        # turn.completed is the completion evidence; the exit code is not
        # consulted (exit 137 + turn.completed is the SIGKILL-orphan idle).
        result["state"] = "idle"
        result["failure"] = None
        result["activity_age_s"] = _age_s(reduction.get("activity_mtime"), handle)
        if not reduction.get("result_available"):
            # Completed turn, but the final-message artifact is missing/empty —
            # still idle (evidence beats the artifact), with reason context.
            result["reason_context"] = {
                "codex": {
                    "reason": CODEX_REASON_MALFORMED_COMPLETION,
                    "message": "turn.completed present but the final-message "
                               "artifact is missing or empty",
                    "result_path": handle.get("result_path"),
                    "exit_code": reduction.get("exit_code"),
                }
            }
        return result

    if state_hint == "terminated":
        # turn.failed — or a process gone with neither completion evidence nor
        # an explicit failure. The exit code rides as reason context only.
        result["state"] = "terminated"
        result["failure"] = reduction.get("failure") or {
            "reason": "no_evidence", "message": None, "exit_code": reduction.get("exit_code"),
        }
        result["activity_age_s"] = _age_s(reduction.get("activity_mtime"), handle)
        return result

    # No authoritative event yet (launch begun): liveness + activity age decide.
    age = _age_s(reduction.get("activity_mtime"), handle)
    result["activity_age_s"] = age
    if alive and age is not None and age > stuck_after:
        result["state"] = "stuck"
        result["failure"] = None
        result["reason_context"] = {
            "codex": {
                "reason": CODEX_REASON_STALE_ACTIVITY,
                "message": f"no event activity for {round(age)}s "
                           f"(threshold {stuck_after}s)",
                "activity_age_s": round(age, 1) if age is not None else None,
                "exit_code": reduction.get("exit_code"),
            }
        }
        return result

    if alive:
        # spawning until the first thread.started proves Codex itself is up.
        result["state"] = "spawning" if handle.get("state") == "spawning" and \
            not reduction.get("thread_started") else "running"
        result["failure"] = None
        return result

    # Defensive: process gone with no verdict (only reachable when the reducer
    # is unavailable — the reducer itself maps this to terminated above).
    result["state"] = "terminated"
    result["failure"] = {
        "reason": "no_evidence", "message": None,
        "exit_code": reduction.get("exit_code"),
    }
    return result


def _derive_pending_attempt(
    result: dict[str, Any],
    reduction: dict[str, Any],
    handle: dict[str, Any],
    alive: bool,
    attempt: int,
) -> dict[str, Any]:
    """Finish a derivation for an attempt whose segment has not started.

    Reached only when ``handle.attempt > segments``: a resume launched, but no
    ``thread.started`` for the newest attempt is in the event artifact yet.
    Liveness decides; the exit status rides as reason context exactly like the
    reducer's ``incomplete`` branch (§5). amux's rc-66 thread-mismatch
    quarantine (foreign output to ``.err``, SIGINT, no event append) lands
    here too and is surfaced as ``thread_mismatch`` — amux's outcome, not a
    re-implementation of its comparison.
    """
    # The new attempt has not touched the event artifact, so its activity
    # clock starts at the resume launch (updated_at), falling back to
    # created_at for a hand-written handle.
    launched_at = _iso_epoch(handle, "updated_at") or _iso_epoch(handle, "created_at")
    age = round(max(0.0, time.time() - launched_at), 1) if launched_at else None
    result["activity_age_s"] = age

    exit_code = reduction.get("exit_code")
    exit_present = bool(reduction.get("exit_code_present"))

    if alive:
        stuck_after = result["stuck_after_s"]
        if age is not None and age > stuck_after:
            result["state"] = "stuck"
            result["failure"] = None
            result["reason_context"] = {
                "codex": {
                    "reason": CODEX_REASON_STALE_ACTIVITY,
                    "message": f"attempt {attempt} launched but no event "
                               f"activity for {round(age)}s "
                               f"(threshold {stuck_after}s)",
                    "activity_age_s": age,
                    "exit_code": exit_code,
                }
            }
        else:
            result["state"] = "running"
            result["failure"] = None
        return result

    # Pane gone before the newest attempt's segment started. Exit code is the
    # only direct evidence, and it is context — the mismatch code is amux's.
    result["state"] = "terminated"
    if exit_present and exit_code == CODEX_EXIT_THREAD_MISMATCH:
        result["failure"] = {
            "reason": CODEX_REASON_THREAD_MISMATCH,
            "message": "amux quarantined the resumed run: the new segment's "
                       "thread id did not match the requested one "
                       f"(see {handle.get('activity_path')}.err)",
            "exit_code": exit_code,
        }
    elif exit_present:
        result["failure"] = {
            "reason": "nonzero_exit" if exit_code else "no_completion_event",
            "message": f"attempt {attempt} ended before its turn started",
            "exit_code": exit_code,
        }
    elif reduction.get("thread_started"):
        result["failure"] = {
            "reason": "no_exit_status",
            "message": f"attempt {attempt} left no exit status (killed launch)",
            "exit_code": None,
        }
    else:
        result["failure"] = {
            "reason": "no_evidence",
            "message": None,
            "exit_code": None,
        }
    return result


def _age_s(activity_mtime: float | None, handle: dict[str, Any]) -> float | None:
    """Seconds since the activity clock ticked (artifact mtime -> created_at)."""
    mtime = activity_mtime
    if mtime is None:
        mtime = _created_at_epoch(handle)
    if mtime is None:
        return None
    return round(max(0.0, time.time() - mtime), 1)


def _derive_status(handle: dict[str, Any], stuck_after_override: int | None) -> dict[str, Any]:
    """Derive a tracked session's state (architecture §6 derivation rules).

    Provider dispatch (task 20-03): a Codex handle derives through
    :func:`_derive_codex_status` (architecture §5 — reducer evidence, event
    mtime, tmux liveness, exit metadata). Everything below is the Claude path,
    unchanged: hooks + transcript mtime, precedence terminated -> stuck ->
    running -> idle. ``stuck`` is derived here and NEVER persisted back to the
    handle.
    """
    if lib.is_codex_handle(handle):
        return _derive_codex_status(handle, stuck_after_override)

    name = str(handle.get("name", ""))
    stored_state = handle.get("state")

    # stuck_after: per-query override wins; else handle.stuck_after_s; else default.
    stuck_after = stuck_after_override
    if stuck_after is None:
        try:
            stuck_after = int(handle.get("stuck_after_s") or lib.DEFAULT_STUCK_AFTER_S)
        except (TypeError, ValueError):
            stuck_after = lib.DEFAULT_STUCK_AFTER_S

    # Activity clock. Epic 20 (20-01) made this provider-neutral: ``activity_path``
    # with ``transcript_path`` as the fallback, so a legacy handle (no
    # ``activity_path`` key at all) and a migrated Claude handle derive
    # identically. (Codex handles never reach this point — they dispatch to
    # _derive_codex_status above.)
    transcript_path = lib.handle_activity_path(handle)

    # 1) terminated: tmux gone, OR producer already recorded terminated (SessionEnd).
    alive = lib.tmux_has_session(name) if name else False
    if not alive or stored_state == "terminated":
        last_state = handle.get("last_state")
        return {
            "name": name,
            "provider": lib.handle_provider(handle),
            "state": "terminated",
            "last_state": last_state,
            "stuck_after_s": stuck_after,
        }

    # 2) active = live background_tasks OR open turn OR no Stop yet (spawning /
    #    mtime_at_stop absent). The spawning clause keeps a just-launched session
    #    active without short-circuiting stuck.
    live_bg = bool(_live_background_tasks(handle))
    mtime_at_stop = handle.get("mtime_at_stop")
    no_stop_yet = (stored_state == "spawning") or (mtime_at_stop is None)

    # Open-turn detection — cheap gate: only parse the tail when the transcript has
    # advanced past the last Stop snapshot (SAME fs clock). A bare mtime bump from a
    # background-completion notification is filtered inside detect_open_turn.
    open_turn = False
    current_mtime = lib.transcript_mtime(transcript_path)
    if current_mtime is not None and isinstance(mtime_at_stop, (int, float)):
        if current_mtime > mtime_at_stop:
            open_turn = lib.detect_open_turn(transcript_path)

    active = live_bg or open_turn or no_stop_yet

    # 3) stuck = active AND (now - activity_mtime > stuck_after). Cause-agnostic.
    #    activity_mtime = transcript mtime if present, else handle.created_at.
    activity_mtime = current_mtime
    if activity_mtime is None:
        activity_mtime = _created_at_epoch(handle)
    age = None
    if activity_mtime is not None:
        age = max(0.0, time.time() - activity_mtime)
    is_stuck = bool(active and age is not None and age > stuck_after)

    if is_stuck:
        state = "stuck"
    elif active:
        state = "running"
    else:
        # 4) idle = not active AND stored state idle.
        #
        # This branch is only reached when active==False.  Per spec, idle ⇔
        # not-active AND stored state == "idle".  Under CC 2.1.185 the
        # draining Stop always sets state="idle" before the session goes
        # quiet, so stored_state should always be "idle" here.  However, if
        # a Stop fires but its state update hasn't been written yet (an
        # in-flight write race that is normally impossible), stored_state may
        # still be "running" or "spawning".  In that case we return the stored
        # intermediate state rather than inventing "idle", because the Stop
        # that would set idle simply hasn't been processed yet — reporting the
        # live stored state is less misleading than a premature "idle".
        state = "idle" if stored_state == "idle" else stored_state or "idle"

    result: dict[str, Any] = {
        "name": name,
        "provider": lib.handle_provider(handle),
        "state": state,
        "stored_state": stored_state,
        "active": active,
        "stuck_after_s": stuck_after,
        "activity_age_s": round(age, 1) if age is not None else None,
        "signals": {
            "live_background_tasks": live_bg,
            "open_turn": open_turn,
            "no_stop_yet": no_stop_yet,
        },
    }
    # Reason-context: best-effort, attached whenever not plainly idle (esp. stuck).
    if state != "idle":
        result["reason_context"] = _reason_context(handle)
    return result


def _iso_epoch(handle: dict[str, Any], key: str) -> float | None:
    """Parse a handle's ISO-8601 timestamp field (e.g. ``created_at``) or None."""
    raw = handle.get(key)
    if not isinstance(raw, str) or not raw:
        return None
    try:
        from datetime import datetime
        return datetime.fromisoformat(raw).timestamp()
    except (ValueError, TypeError):
        return None


def _created_at_epoch(handle: dict[str, Any]) -> float | None:
    """Parse ``created_at`` (ISO-8601) into an epoch float, or None."""
    return _iso_epoch(handle, "created_at")


def _resolve_handle(handle_arg: str) -> tuple[str, dict[str, Any] | None]:
    """Resolve a queried <handle> (amux session name) to its handle dict.

    The queried token is the amux session name (the handle key). Returns
    ``(name, handle_or_none)`` — fail-soft (None handle when absent/malformed).
    """
    name = handle_arg.strip()
    return name, lib.read_handle(name)


def _human_status_line(result: dict[str, Any]) -> str:
    """One-line human summary of a status result."""
    name = result.get("name", "?")
    state = result.get("state", "unknown")
    bits = [f"{name}: {state}"]
    if state == "terminated":
        ls = result.get("last_state")
        if ls:
            bits.append(f"(last_state={ls})")
        # Codex terminated: the normalized failure reason is the headline
        # (architecture §6). Claude results carry no "failure" key.
        summary = _codex_failure_summary(result)
        if summary:
            bits.append(f"({summary})")
    else:
        age = result.get("activity_age_s")
        if age is not None:
            bits.append(f"(idle/active {age}s, stuck_after={result.get('stuck_after_s')}s)")
        rc = result.get("reason_context") or {}
        causes = []
        if rc.get("background_tasks"):
            causes.append(f"{len(rc['background_tasks'])} bg task(s)")
        if rc.get("foreground_tool"):
            ft = rc["foreground_tool"]
            causes.append(f"foreground {ft.get('tool')}")
        if rc.get("pending_permission"):
            pp = rc["pending_permission"]
            causes.append(f"pending permission {pp.get('tool_name')}")
        if causes:
            bits.append("— " + ", ".join(causes))
    return " ".join(bits)


def cmd_status(args: argparse.Namespace) -> int:
    """``status <handle>`` — report a tracked session's derived state + reason-context."""
    if not getattr(args, "handle", None):
        _eprint("amux-spawn status: missing <handle>")
        return 2
    stuck_after_override = (
        parse_stuck_after(args.stuck_after) if getattr(args, "stuck_after", None) else None
    )
    name, handle = _resolve_handle(args.handle)
    if handle is None:
        result: dict[str, Any] = {"name": name, "state": "unknown", "error": "no handle found"}
        if args.json:
            print(json.dumps(result))
        else:
            print(f"{name}: unknown (no tracked handle found)")
        return 1
    result = _derive_status(handle, stuck_after_override)
    if args.json:
        print(json.dumps(result))
    else:
        print(_human_status_line(result))
    return 0


def cmd_last(args: argparse.Namespace) -> int:
    """``last <handle>`` — print the handle's last message.

    The derivation is :func:`_final_message` — the SAME read path the
    ``--wait`` completion print uses, so the two surfaces cannot diverge
    (sign-off finding F1). Claude: the producer hook's ``last_message``.
    Codex: the explicit final-message artifact (``--output-last-message``),
    read through the reducer's bounded reader — never Codex's internal
    transcript format (BRD §4.2 / invariant 5). The bound is the reducer's
    ``MAX_RESULT_BYTES`` (256 KiB); a larger artifact is truncated, not
    rejected.
    """
    if not getattr(args, "handle", None):
        _eprint("amux-spawn last: missing <handle>")
        return 2
    name, handle = _resolve_handle(args.handle)
    if handle is None:
        if args.json:
            print(json.dumps({"name": name, "last_message": None, "error": "no handle found"}))
        else:
            _eprint(f"amux-spawn last: no tracked handle found for {name}")
        return 1
    if lib.is_codex_handle(handle):
        last_message = _final_message(handle)
        if args.json:
            print(json.dumps({
                "name": name,
                "provider": lib.PROVIDER_CODEX,
                "last_message": last_message,
                "result_path": handle.get("result_path"),
            }))
        else:
            if last_message is None:
                _eprint(
                    f"amux-spawn last: {name} has no final-message artifact yet "
                    f"({handle.get('result_path')})"
                )
                return 1
            print(last_message)
        return 0
    last_message = _final_message(handle)
    if args.json:
        print(json.dumps({"name": name, "last_message": last_message}))
    else:
        if last_message is None:
            _eprint(f"amux-spawn last: {name} has no last_message yet")
            return 1
        print(last_message)
    return 0


def cmd_ls(args: argparse.Namespace) -> int:
    """``ls`` — list tracked sessions for the current workspace and/or run_id.

    Reads the registry (``~/.amux/spawn/*.json``). Marks dead handles
    (``tmux has-session`` false); no auto-cleanup — the registry accumulates them.
    Filters: ``--all`` lists every workspace; otherwise the resolved CC_DIR (or
    ``--dir``); ``--run-id`` further narrows.
    """
    if getattr(args, "all", False):
        target_dir = None
    elif getattr(args, "dir", None):
        target_dir = os.path.abspath(os.path.expanduser(args.dir))
    else:
        # Resolve the current workspace: parent CC_DIR if in an amux session, else cwd.
        parent = lib.resolve_amux_session()
        cc_dir = lib.parent_cc_dir(parent) if parent else None
        target_dir = os.path.abspath(cc_dir) if cc_dir else os.path.abspath(os.getcwd())

    run_id = getattr(args, "run_id", None)

    rows: list[dict[str, Any]] = []
    for handle in lib.list_handles():
        if not isinstance(handle, dict):
            continue
        hdir = handle.get("dir")
        if target_dir is not None:
            if not isinstance(hdir, str) or os.path.abspath(hdir) != target_dir:
                continue
        if run_id is not None and handle.get("run_id") != run_id:
            continue
        name = str(handle.get("name", ""))
        alive = lib.tmux_has_session(name) if name else False
        attempt: int | None = None
        if lib.is_codex_handle(handle):
            # A dead tmux session is NOT termination for a bounded Codex run
            # (architecture §5): the row state must come from the same
            # derivation as ``status``. Fail-soft on any derivation error.
            # Task 20-04: the derivation also carries the attempt counter —
            # inspectable history for resumed workers (architecture §6).
            try:
                derived = _derive_status(handle, None)
                state = derived.get("state", handle.get("state"))
                attempt = derived.get("attempt")
            except Exception:  # noqa: BLE001
                state = handle.get("state")
        else:
            state = "terminated" if (not alive or handle.get("state") == "terminated") else handle.get("state")
        row = {
            "name": name,
            "provider": lib.handle_provider(handle),
            "alive": alive,
            "state": state,
            "run_id": handle.get("run_id"),
            "dir": hdir,
        }
        if lib.is_codex_handle(handle):
            row["attempt"] = attempt
        rows.append(row)

    rows.sort(key=lambda r: r["name"])
    if args.json:
        print(json.dumps({"dir": target_dir, "run_id": run_id, "sessions": rows}))
    else:
        if not rows:
            scope = "all workspaces" if target_dir is None else target_dir
            print(f"amux-spawn ls: no tracked sessions in {scope}")
        else:
            for r in rows:
                mark = "live " if r["alive"] else "dead "
                print(f"{mark} {r['name']:<28} {r['state'] or '?':<11} run={r['run_id']}")
    return 0


def cmd_attach(args: argparse.Namespace) -> int:
    """``a|attach [<suffix>]`` — fuzzy-switch to a session in the current workspace.

    Resolution (architecture §3 / D-Switch):
      - prefix = basename(cwd) — the SAME algorithm spawn uses (shared via
        lib.workspace_prefix / lib.resolve_attach_target).
      - target = <prefix>-<suffix> when suffix given; bare <prefix> when not.
      - If the cwd-prefix exact match fails, fall back to fuzzy match across the
        WHOLE session list, ranking current-workspace candidates FIRST.
      - Ambiguous → list candidates, no switch (never silently attach the wrong one).
      - Not found → clear error message.
      - Confirms liveness via amux ls (the session list) before switching.
      - Inside tmux ($TMUX) → switch-client (task 12 E3, via `amux attach`);
        else → attach-session (also via `amux attach`, which auto-detects).
    """
    suffix = getattr(args, "suffix", None) or None  # "" → None

    kind, payload = lib.resolve_attach_target(suffix)

    if kind == lib.ATTACH_NOT_FOUND:
        tried = payload
        _eprint(f"amux-spawn: no session found matching '{tried}'")
        _eprint("  (run `amux ls` to see available sessions)")
        return 1

    if kind == lib.ATTACH_AMBIGUOUS:
        candidates = payload
        _eprint("amux-spawn: ambiguous — multiple sessions match:")
        for name in candidates:
            _eprint(f"  {name}")
        _eprint("  specify a more precise suffix to pick one")
        return 1

    # ATTACH_EXACT — one resolved name.
    target = payload
    assert isinstance(target, str)

    # Confirm liveness before attempting the switch (architecture §3 / D-Switch).
    # We check via amux ls names (already fetched inside resolve_attach_target)
    # AND via tmux has-session so we catch sessions that lost their tmux pane
    # but are still in amux's registry.
    if not lib.tmux_has_session(target):
        _eprint(f"amux-spawn: session '{target}' is not live (tmux has-session false)")
        _eprint("  the session may have ended; use `amux ls` to check")
        return 1

    # Delegate to amux attach which already does switch-client inside tmux (E3)
    # and attach-session otherwise — same helper the spawn TTY path uses.
    _amux_attach(target)
    # _amux_attach uses os.execvp, so we only reach here on failure.
    return 1


# ── rm: reap a tracked session (task 10-06) ──────────────────────────────────


def _amux_rm(name: str) -> None:
    """Run ``amux rm <name>`` (best-effort).

    Tolerates the "unknown session" case — amux's ``resolve_session`` exits
    non-zero with "not found" on stderr when the session was never registered
    or was already removed from amux's registry (the tmux side may already be
    gone).  Any OTHER failure is surfaced as a warning on STDERR so the caller
    can diagnose it:

    - ``FileNotFoundError``: amux binary is not on PATH.
    - ``subprocess.TimeoutExpired``: amux took > 10 s.
    - Non-zero returncode with unrecognised stderr: unexpected amux error.

    Never raises.
    """
    try:
        result = subprocess.run(
            ["amux", "rm", name],
            capture_output=True,
            text=True,
            timeout=10,
        )
    except FileNotFoundError:
        _eprint(f"amux-spawn rm: warning: amux binary not found; skipping 'amux rm {name}'")
        return
    except subprocess.TimeoutExpired:
        _eprint(f"amux-spawn rm: warning: 'amux rm {name}' timed out (>10 s)")
        return
    except Exception as exc:  # noqa: BLE001
        _eprint(f"amux-spawn rm: warning: 'amux rm {name}' failed unexpectedly: {exc}")
        return

    if result.returncode != 0:
        stderr_text = (result.stderr or "").strip()
        if "not found" in stderr_text:
            # amux resolve_session emits "error: session '<name>' not found"
            # when the session was never registered or was already cleaned up.
            # This is expected; stay silent.
            return
        _eprint(
            f"amux-spawn rm: warning: 'amux rm {name}' exited {result.returncode}"
            + (f": {stderr_text}" if stderr_text else "")
        )


def cmd_rm(args: argparse.Namespace) -> int:
    """``rm <handle>`` — reap a tracked session (registry end-of-life, task 10-06).

    Resolves the handle via ``_resolve_handle`` (name-global / cwd-independent,
    parity with ``status`` and ``last``).  Derives the state using 10-03
    semantics.  If the derived state is ``running`` or ``stuck``, refuses with
    a descriptive error and exits non-zero — UNLESS ``--force`` is given, in
    which case the session is killed regardless.

    On success (or with ``--force``):
      1. Runs ``amux rm <name>`` to stop tmux + remove the amux registration +
         delete ``<name>.meta.json``.  Tolerates any amux failure (unknown
         session, amux unavailable, etc.).
      2. Deletes ``~/.amux/spawn/<name>.json`` from the registry.
      3. Codex only: deletes the exact event/result artifacts the handle
         names (plus their ``.err``/``.rc`` siblings) — no broad glob.

    Output: a human one-liner by default; ``--json`` emits
    ``{name, state_at_rm, killed}`` where ``killed`` is true iff the session
    was live (running/stuck) when reaped.  Exit 0 on success; 1 on error.
    """
    name, handle = _resolve_handle(args.handle)
    if handle is None:
        _eprint(f"amux-spawn rm: no tracked handle found for '{name}'")
        return 1

    # Derive state using the same 10-03 logic as ``status``.
    result = _derive_status(handle, None)
    state = result.get("state", "unknown")

    force = bool(getattr(args, "force", False))

    # Guard: a live session is a kill — the caller must mean it. ``spawning``
    # only ever derives for a just-launched Codex worker (a Claude handle maps
    # spawning to running/stuck), so including it changes nothing for Claude.
    if state in ("running", "stuck", "spawning") and not force:
        _eprint(
            f"amux-spawn rm: session '{name}' is {state} — refusing to reap "
            f"without --force"
        )
        _eprint("  (use --force to kill and remove the session)")
        return 1

    killed = state in ("running", "stuck", "spawning")

    # 1) Ask amux to stop the tmux session + remove its registration +
    #    delete meta.json.  Tolerate any failure.  amux stops the pane via
    #    ``tmux kill-session`` (never a bare kill -9 — the 01-01 orphan
    #    evidence), which is exactly what a bounded worker needs.
    _amux_rm(name)

    # 2) Remove the spawn registry handle.
    lib.delete_handle(name)

    # 3) Codex: reap THIS handle's bounded-run artifacts — exactly the event
    #    log + its amux-owned ``.err``/``.rc`` siblings + the result file the
    #    handle names, never a glob (architecture §9). Nothing else in the
    #    registry dir is touched.
    if lib.is_codex_handle(handle):
        lib.remove_codex_artifacts(
            handle.get("activity_path"), handle.get("result_path")
        )

    # Output.
    if args.json:
        print(json.dumps({"name": name, "state_at_rm": state, "killed": killed}))
    else:
        verb = "killed and removed" if killed else "removed"
        print(f"amux-spawn rm: {name} ({state}) {verb}")

    return 0


# ── profiles (task 13-02) ─────────────────────────────────────────────────────

def cmd_profiles(args: argparse.Namespace) -> int:
    """``profiles [--json]`` — list available model profiles.

    Human-readable: name / model / provider table.
    ``--json``: array of ``{name, env}`` objects.
    """
    from urllib.parse import urlparse

    profiles = lib.load_profiles()

    if args.json:
        output = [{"name": name, "env": env} for name, env in sorted(profiles.items())]
        print(json.dumps(output))
        return 0

    if not profiles:
        print("amux-spawn: no profiles found (missing ~/.claude/profiles.toml or no [profile.*] sections)")
        return 0

    rows: list[tuple[str, str, str]] = []
    for name, env in sorted(profiles.items()):
        # Model: ANTHROPIC_MODEL if set, else first of the default model vars.
        model = (
            env.get("ANTHROPIC_MODEL")
            or env.get("ANTHROPIC_DEFAULT_OPUS_MODEL")
            or env.get("ANTHROPIC_DEFAULT_SONNET_MODEL")
            or ""
        )
        # Provider: hostname from ANTHROPIC_BASE_URL if set, else "anthropic".
        base_url = env.get("ANTHROPIC_BASE_URL", "")
        if base_url:
            try:
                provider = urlparse(base_url).hostname or "anthropic"
            except Exception:  # noqa: BLE001
                provider = "anthropic"
        else:
            provider = "anthropic"
        rows.append((name, model, provider))

    # Format as an aligned table.
    col_name_w = max(len("NAME"), *(len(r[0]) for r in rows))
    col_model_w = max(len("MODEL"), *(len(r[1]) for r in rows))
    fmt = f"{{:<{col_name_w}}}  {{:<{col_model_w}}}  {{}}"
    print(fmt.format("NAME", "MODEL", "PROVIDER"))
    print(fmt.format("-" * col_name_w, "-" * col_model_w, "-" * 8))
    for name, model, provider in rows:
        print(fmt.format(name, model, provider))
    return 0


# ── CLI dispatch ──────────────────────────────────────────────────────────────

def _split_prompt(argv: list[str]) -> tuple[list[str], str | None]:
    """Split off amux-spawn's own ``--`` separator and the seeded prompt.

    Everything after the first ``--`` is the prompt (joined with spaces if the
    caller's shell tokenized it). Returns ``(args_before, prompt_or_none)``.
    """
    if "--" not in argv:
        return argv, None
    idx = argv.index("--")
    before = argv[:idx]
    after = argv[idx + 1:]
    prompt = " ".join(after) if after else None
    return before, prompt


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="amux-spawn",
        description="Unified human + agent launcher for amux sessions.",
        add_help=True,
    )
    sub = parser.add_subparsers(dest="subcommand")

    sp = sub.add_parser(
        "spawn", help="create + seed a new amux session", add_help=True,
        epilog=(
            "value-taking pass-through flags: prefer the --flag=value form. "
            "The space form's value (e.g. the model in `--model gpt-5.5`) can "
            "be captured by the optional <suffix> positional — pre-existing "
            "behavior, identical for both providers; `--model=gpt-5.5` "
            "round-trips verbatim. Codex model selection is never implicit: "
            "with no explicit --model=<name>, Codex's own config "
            "(~/.codex/config.toml) decides. --profile is Claude's "
            "~/.claude/profiles.toml concept and is refused for codex."
        ),
    )
    sp.add_argument("suffix", nargs="?", default=None,
                    help="optional memorable name suffix (else auto-increment)")
    sp.add_argument("--detach", action="store_true",
                    help="force detached launch even at a TTY")
    sp.add_argument("--wait", action="store_true",
                    help="block until the seeded turn reaches idle; print last_message to stdout")
    sp.add_argument("--notify", action="store_true",
                    help="alias for --wait; intended for run_in_background orchestrator pattern")
    sp.add_argument("--timeout", default=None,
                    help="--wait patience limit (e.g. 30s, 5m); on expiry print "
                         f"'{WAIT_TIMEOUT_MARKER}' to stdout and exit 3")
    sp.add_argument("--dir", default=None, help="explicit workspace dir override")
    sp.add_argument("--provider", default=lib.PROVIDER_CLAUDE,
                    help="agent CLI to launch: "
                         f"{'|'.join(lib.PROVIDERS)} (default: {lib.PROVIDER_CLAUDE}). "
                         "'codex' launches a bounded `codex exec` worker: always "
                         "tracked and detached, and it needs a prompt after --")
    sp.add_argument("--yolo", action="store_true",
                    help="forward amux's provider-neutral --yolo; amux expands it "
                         "per provider (claude: --dangerously-skip-permissions, "
                         "codex: --dangerously-bypass-approvals-and-sandbox)")
    sp.add_argument("--run-id", default=None, help="override the inherited/minted run_id")
    sp.add_argument("--stuck-after", default=None,
                    help="stuck threshold (e.g. 10m, 600, 2h); persisted in the handle")
    sp.add_argument("--profile", default=None,
                    help="model profile name from ~/.claude/profiles.toml; "
                         "resolved env vars are exported before spawning")

    prof = sub.add_parser("profiles", help="list available model profiles from profiles.toml")
    prof.add_argument("--json", action="store_true", help="machine-readable JSON output")

    rs = sub.add_parser(
        "resume", help="start the next bounded turn on a captured Codex thread",
        epilog=(
            "resumes the EXACT thread captured by the first turn (amux's "
            "meta.json); a missing or malformed thread id is refused, never "
            "silently restarted on a fresh thread. -m/--model may pass through "
            "(both `--model X` and `--model=X` work here — resume has no "
            "suffix positional); -p/--profile, -C/--cd and -s/--sandbox are "
            "refused because `codex exec resume` rejects them; --yolo and the "
            "workspace are fixed at spawn time and inherited."
        ),
    )
    rs.add_argument("handle", help="amux session name (handle key); must be a codex worker")
    rs.add_argument("--json", action="store_true",
                    help="machine-readable JSON outcome")
    rs.add_argument("--wait", action="store_true",
                    help="block until the resumed turn reaches idle; print the "
                         "final message to stdout")
    rs.add_argument("--notify", action="store_true",
                    help="alias for --wait; intended for run_in_background orchestrator pattern")
    rs.add_argument("--timeout", default=None,
                    help="--wait patience limit (e.g. 30s, 5m); on expiry print "
                         f"'{WAIT_TIMEOUT_MARKER}' to stdout and exit 3")
    # Defined so each gets its own actionable refusal message instead of
    # riding the pass-through flags into a doomed launch.
    rs.add_argument("--yolo", action="store_true",
                    help="REFUSED on resume: YOLO is fixed at spawn time and "
                         "inherited by resumed runs")
    rs.add_argument("--profile", default=None,
                    help="REFUSED on resume: Claude profiles are a spawn-time "
                         "concept and codex exec resume rejects -p/--profile")
    rs.add_argument("--dir", default=None,
                    help="REFUSED on resume: the resumed run keeps the "
                         "session's spawned workspace")

    st = sub.add_parser("status", help="report a tracked session's derived state")
    st.add_argument("handle", help="amux session name (handle key)")
    st.add_argument("--json", action="store_true", help="machine-readable output")
    st.add_argument("--stuck-after", default=None,
                    help="override the stuck threshold for this query (e.g. 5s, 10m)")

    la = sub.add_parser("last", help="print a tracked session's last message")
    la.add_argument("handle", help="amux session name (handle key)")
    la.add_argument("--json", action="store_true", help="machine-readable output")

    lsp = sub.add_parser("ls", help="list tracked sessions for the workspace")
    lsp.add_argument("--json", action="store_true", help="machine-readable output")
    lsp.add_argument("--all", action="store_true", help="list every workspace, not just this one")
    lsp.add_argument("--dir", default=None, help="filter by an explicit workspace dir")
    lsp.add_argument("--run-id", default=None, help="filter by run_id")

    rm = sub.add_parser(
        "rm",
        help="reap a tracked session (end-of-life: stop tmux + delete registry handle)",
    )
    rm.add_argument("handle", help="amux session name (handle key)")
    rm.add_argument(
        "--force",
        action="store_true",
        help="kill and remove even if the session is running or stuck",
    )
    rm.add_argument("--json", action="store_true", help="machine-readable JSON output")

    # Quick-switch (task 10-05): a|attach [<suffix>]
    for _acmd in ("a", "attach"):
        _ap = sub.add_parser(
            _acmd,
            help="fuzzy-switch to a session in the current workspace",
        )
        _ap.add_argument(
            "suffix",
            nargs="?",
            default=None,
            help=(
                "optional session suffix; resolves <prefix>-<suffix>. "
                "Omit to attach the workspace's bare-<prefix> session."
            ),
        )

    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)

    if not argv:
        build_parser().print_help()
        return 0

    subcommand = argv[0]

    if subcommand == "spawn":
        # Split the prompt first so claude flags (which argparse doesn't know
        # about) and the prompt are handled outside argparse's strict parsing.
        rest = argv[1:]
        before, prompt = _split_prompt(rest)
        parser = build_parser()
        # parse_known_args lets pass-through claude flags (e.g. --model,
        # --append-system-prompt) through to forward_flags untouched.
        ns, claude_flags = parser.parse_known_args(["spawn"] + before)
        return cmd_spawn(ns, claude_flags, prompt)

    if subcommand == "resume":
        # Same shape as spawn: the prompt after the first `--` is split off,
        # and unknown value-taking flags (e.g. --model) ride the pass-through
        # list. resume has no optional suffix positional, so BOTH the
        # `--model X` and `--model=X` spellings reach amux intact.
        rest = argv[1:]
        before, prompt = _split_prompt(rest)
        parser = build_parser()
        ns, pass_through = parser.parse_known_args(["resume"] + before)
        return cmd_resume(ns, pass_through, prompt)

    if subcommand == "profiles":
        ns = build_parser().parse_args(argv)
        return cmd_profiles(ns)

    if subcommand in ("status", "last", "ls"):
        ns = build_parser().parse_args(argv)
        if subcommand == "status":
            return cmd_status(ns)
        if subcommand == "last":
            return cmd_last(ns)
        return cmd_ls(ns)
    if subcommand == "rm":
        ns = build_parser().parse_args(argv)
        return cmd_rm(ns)
    if subcommand in ("a", "attach"):
        ns = build_parser().parse_args(argv)
        return cmd_attach(ns)
    if subcommand in ("-h", "--help", "help"):
        build_parser().print_help()
        return 0

    _eprint(f"amux-spawn: unknown subcommand: {subcommand}")
    build_parser().print_help()
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except OSError as exc:
        if exc.errno == errno.EPIPE:
            sys.exit(0)
        raise
