# Environment variables for the relay-server Docker Compose stack.
#
# Copy this file to .env, fill in real values, and keep .env out of version
# control (it is listed in .gitignore).  This example file is safe to commit.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- Required ---------------------------------------------------------------

# Telegram bot token from @BotFather.
RELAY_BOT_TOKEN=123456789:AA...

# Random string embedded in the webhook URL path (acts as a shared secret).
RELAY_WEBHOOK_SECRET=change-me-long-random-string

# Public HTTPS base URL of the relay server (no trailing slash).
# Used by the server to register the webhook with Telegram on startup.
RELAY_PUBLIC_URL=https://relay.example.com

# Hostname for the Caddy label (same host as above, without https://).
# caddy-docker-proxy uses this to generate the Caddyfile entry.
RELAY_PUBLIC_HOST=relay.example.com

# ---- Optional ---------------------------------------------------------------

# Seconds between expired-message cleanup ticks (default: 30).
# RELAY_REAPER_INTERVAL=30

# Name of the external Docker network shared with caddy-docker-proxy
# (default: front-proxy).
# CADDY_NETWORK=front-proxy
