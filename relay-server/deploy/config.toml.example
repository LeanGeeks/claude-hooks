# /etc/relay/config.toml — relay server configuration
# Env var equivalents (higher precedence than this file) are shown in comments.

# Required: Telegram bot token from @BotFather.
# Env: RELAY_BOT_TOKEN
bot_token = "123456789:AAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Required: random string appended to the webhook URL path.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Env: RELAY_WEBHOOK_SECRET
webhook_secret = "change-me-long-random-string"

# Required: public HTTPS base URL of this server (no trailing slash).
# The server calls setWebhook with {public_url}/telegram/webhook/{webhook_secret}.
# Env: RELAY_PUBLIC_URL
public_url = "https://relay.example.com"

# Path to the SQLite database file.
# Default: relay.db (current working directory)
# Env: RELAY_DB_PATH
db_path = "/var/lib/relay/relay.db"

# Address and port for uvicorn to bind.  Caddy proxies to this.
# Default: 127.0.0.1:8080
# Env: RELAY_LISTEN
listen = "127.0.0.1:8080"

# Seconds between reaper ticks (expires open messages, GC idempotency keys).
# Default: 30
# Env: RELAY_REAPER_INTERVAL
reaper_interval = 30

# Default nudge ladder for a chat that has nudges on but no /nudge schedule of
# its own.  Comma-separated durations in active time.
# Default: "15m,45m,3h"
# nudge_default_schedule = "15m,45m,3h"

# Maximum rungs in a per-chat ladder (/nudge command, admin CLI).  A longer
# ladder is rejected, not truncated.
# Default: 3
# Env: RELAY_NUDGE_MAX
# nudge_max = 3

# Maximum rungs in a per-message nudge_schedule supplied at send time
# (POST /v1/messages).  Independent of nudge_max.  Longer is rejected with 422.
# Default: 8
# Env: RELAY_NUDGE_MESSAGE_MAX
# nudge_message_max = 8
