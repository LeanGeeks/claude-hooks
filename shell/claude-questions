# ── Module loading — installed path first, then repo checkout ──────────────────
#
# Resolution mirrors telegram_permission_router.py and claude-roles:
#   1. ~/.claude/hooks/  (after install.sh --yes)
#   2. Walk up from this script for .claude/hooks/  (repo checkout)


def _ensure_hooks_on_path() -> None:
    installed = Path.home() / ".claude" / "hooks"
    if installed.is_dir() and str(installed) not in sys.path:
        sys.path.insert(0, str(installed))
        return
    here = Path(__file__).resolve()
    for parent in here.parents:
        candidate = parent / ".claude" / "hooks"
        if candidate.is_dir():
            if str(candidate) not in sys.path:
                sys.path.insert(0, str(candidate))
            return


_ensure_hooks_on_path()

